index 983be5b..27d4f4b 100644
--- a/src/ngx_http_headers_more_headers_in.c
+++ b/src/ngx_http_headers_more_headers_in.c
@@ -7,6 +7,7 @@
 #ifndef DDEBUG
 #define DDEBUG 0
 #endif
+#include <ngx_config.h>
 #include "ddebug.h"


