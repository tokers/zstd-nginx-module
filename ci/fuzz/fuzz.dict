# libFuzzer dictionary for the Accept-Encoding parser.
# Tokens the grammar actually uses — steers the fuzzer past the
# structural boilerplate (codings, q-values, separators) far faster
# than random bytes.
#
# The coding-name block below is GENERATED by ci/fuzz/gen_dict.sh from the
# ngx_http_zstd_coding_weight(ae, "TOKEN", ...) call sites in src/*.c — do
# not hand-edit between the markers, run the script instead. A hand-listed
# dictionary of this module's own tokens goes stale silently (a merely
# incomplete dictionary still produces a green crash-only fuzz run), and
# ci/linter/lint-c.sh runs `gen_dict.sh --check` to catch the drift.
# BEGIN generated coding tokens (ci/fuzz/gen_dict.sh)
"dcz"
"zstd"
# END generated coding tokens
# Other IANA content-codings a real client sends alongside zstd/dcz — not
# this module's own tokens, but exercising the "not our coding" branches
# (coding_q stays -1, falls through to the wildcard check) is part of the
# same grammar surface.
"gzip"
"deflate"
"br"
"identity"
"compress"
"*"
";q="
"q=0"
"q=1"
"q=0.0"
"q=1.0"
", "
","
";"
"="
" "
"\x09"
